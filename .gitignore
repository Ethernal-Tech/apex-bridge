# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
apex-bridge

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

.vscode

# Go workspace file
go.work

*.db
*.log
contractbuild

*/keys
/blade-dir

# >>> ethernal core (managed) >>>
# Claude Code: personal and session state
.claude/settings.local.json
.claude/ethernal/handoff.md
.claude/ethernal/state.json
.claude/ethernal/state.lock
.claude/ethernal/hooks.log
.claude/ethernal/hook-crash-*
.claude/worktrees/
# Secrets: environment files, except the examples
.env
.env.*
!.env*.example
!.env*.sample
# <<< ethernal core (managed) <<<
